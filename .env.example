# Copy to .env. Never commit .env or any key file.

# Claude review agent (topoflow review). Or run `ant auth login` instead.
ANTHROPIC_API_KEY=

# Google Earth Engine, for TROPOMI XCH4: a Cloud project registered for Earth Engine (noncommercial).
EARTHENGINE_PROJECT=

# Copernicus CDS uses ~/.cdsapirc; these override it.
CDSAPI_URL=
CDSAPI_KEY=

# Your own files (optional). ERA5 u10/v10 NetCDF, and a folder of daily YYYYMMDD.nc CH4 files.
TOPOFLOW_U_FILE=
TOPOFLOW_V_FILE=
TOPOFLOW_METHANE_DIR=
# Needed when the CH4 files hold more than one variable or carry no units attribute.
TOPOFLOW_METHANE_VAR=
TOPOFLOW_METHANE_UNIT=

# Dashboard: a specific run folder instead of the newest.
TOPOFLOW_RUN=
